<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/haohao_selection_surface" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/haohao_brand_header_pressed" />
            <stroke android:width="1dp" android:color="@color/haohao_segment_border" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/haohao_segment_surface" />
            <stroke android:width="1dp" android:color="@color/haohao_segment_border" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
