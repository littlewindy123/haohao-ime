<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/haohao_page_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pinyin_fuzzy_description"
            android:textColor="@color/haohao_cocoa_secondary"
            android:textSize="15sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/fuzzy_master_switch"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:text="@string/pinyin_fuzzy_master"
            android:textAppearance="@style/TextAppearance.HaoHao.SettingTitle"
            app:thumbTint="@color/haohao_switch_thumb"
            app:trackTint="@color/haohao_switch_track" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/haohao_divider" />

        <TextView
            android:id="@+id/custom_config_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/pinyin_correction_custom_config"
            android:textColor="@color/haohao_cocoa_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/fuzzy_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/apply_button"
            style="@style/Widget.HaoHao.HeaderButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:text="@string/pinyin_fuzzy_apply" />
    </LinearLayout>
</ScrollView>
