<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/haohao_page_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    tools:context=".ui.setup.SetupFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <ImageView
            android:id="@+id/step_icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/haohao_preview_badge_background"
            android:contentDescription="@null"
            android:padding="22dp"
            android:src="@drawable/ic_baseline_keyboard_24"
            app:tint="@color/haohao_header_foreground" />

        <TextView
            android:id="@+id/step_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.HaoHao.SetupTitle"
            tools:text="启用好好输入法" />

        <TextView
            android:id="@+id/hint_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/haohao_cocoa_secondary"
            android:textSize="16sp"
            tools:text="在系统设置中打开好好输入法，返回后会自动继续。" />

        <LinearLayout
            android:id="@+id/done_state"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/haohao_preview_badge_background"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/done_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_baseline_check_circle_24"
                app:tint="@color/haohao_header_foreground" />

            <TextView
                android:id="@+id/done_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/haohao_header_foreground"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="这一步已完成" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/action_button"
            style="@style/Widget.HaoHao.SetupPrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="26dp"
            tools:text="前往系统设置" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
