<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/haohao_page_background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cloud_translation_provider"
            android:textAppearance="@style/TextAppearance.HaoHao.SectionTitle" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/haohao_search_background"
            android:minHeight="56dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/haohao_cocoa_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/provider_public"
                style="@style/Widget.HaoHao.SegmentButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="@string/cloud_translation_provider_public" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/provider_aliyun"
                style="@style/Widget.HaoHao.SegmentButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="@string/cloud_translation_provider_aliyun" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/provider_custom"
                style="@style/Widget.HaoHao.SegmentButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="@string/cloud_translation_provider_custom" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:drawablePadding="10dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/cloud_translation_privacy"
            android:textColor="@color/haohao_cocoa_secondary"
            android:textSize="14sp"
            app:drawableStartCompat="@drawable/ic_baseline_lock_24" />

        <LinearLayout
            android:id="@+id/public_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/public_status"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:text="@string/cloud_translation_status_preparing"
                android:textAppearance="@style/TextAppearance.HaoHao.SettingTitle" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/aliyun_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:importantForAutofill="noExcludeDescendants"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/aliyun_access_key_id"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/haohao_search_background"
                android:hint="@string/cloud_translation_aliyun_access_key_id"
                android:inputType="textNoSuggestions"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="@color/haohao_cocoa"
                android:textColorHint="@color/haohao_cocoa_secondary" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/aliyun_access_key_secret"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/haohao_search_background"
                android:hint="@string/cloud_translation_aliyun_access_key_secret"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="@color/haohao_cocoa"
                android:textColorHint="@color/haohao_cocoa_secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/cloud_translation_aliyun_saved_secret"
                android:textColor="@color/haohao_cocoa_secondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/cloud_translation_aliyun_ram_hint"
                android:textColor="@color/haohao_cocoa_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/custom_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:importantForAutofill="noExcludeDescendants"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/custom_endpoint"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/haohao_search_background"
                android:hint="@string/cloud_translation_custom_endpoint"
                android:inputType="textUri"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="@color/haohao_cocoa"
                android:textColorHint="@color/haohao_cocoa_secondary" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/custom_token"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/haohao_search_background"
                android:hint="@string/cloud_translation_custom_token"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="@color/haohao_cocoa"
                android:textColorHint="@color/haohao_cocoa_secondary" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="@color/haohao_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cloud_translation_candidate_source"
                android:textAppearance="@style/TextAppearance.HaoHao.SettingTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/cloud_translation_candidate_source_summary"
                android:textColor="@color/haohao_cocoa_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/candidate_source_local"
                    style="@style/Widget.HaoHao.SegmentButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:text="@string/cloud_translation_source_local" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/candidate_source_cloud"
                    style="@style/Widget.HaoHao.SegmentButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:text="@string/cloud_translation_source_cloud" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/candidate_source_hybrid"
                    style="@style/Widget.HaoHao.SegmentButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:text="@string/cloud_translation_source_hybrid" />
            </LinearLayout>
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/test_apply_button"
            style="@style/Widget.HaoHao.SetupPrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="@string/cloud_translation_test_apply" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
