<resources>
    <style name="Theme.TrimeAppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/haohao_product_accent</item>
        <item name="android:colorAccent">@color/haohao_product_accent</item>
        <item name="android:colorBackground">@color/haohao_page_background</item>
        <item name="android:textColorPrimary">@color/haohao_cocoa</item>
